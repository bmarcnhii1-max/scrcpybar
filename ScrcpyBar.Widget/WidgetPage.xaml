<Page
    x:Class="ScrcpyBar.Widget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Buttons must not fall back to the system accent color on hover/press: inside
             Game Bar that accent can be any color and look out of place. -->
        <SolidColorBrush x:Key="SubtleHover">22FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SubtlePressed">2EFFFFFF</SolidColorBrush>

        <ControlTemplate x:Key="SubtleButtonTemplate" TargetType="Button">
            <Grid x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"/>
                        <VisualState x:Name="Pressed"/>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Padding="{TemplateBinding Padding}"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="Subtle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}"
                              Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                            To="#22FFFFFF" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                            To="#2EFFFFFF" Duration="0:0:0.02"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleGreen" TargetType="Button" BasedOn="{StaticResource Subtle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}"
                              Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                            To="#15803D" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                            Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                            To="#0E5C2D" Duration="0:0:0.02"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#E00B0F19" Padding="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.png"
                       Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="SCRCPY BAR" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" CharacterSpacing="60" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="LyricsToggleBtn" Content="Текст" FontSize="10" Padding="8,3"
                        Style="{StaticResource Subtle}"
                        Background="#15FFFFFF" Foreground="#9CA3AF" BorderThickness="1" BorderBrush="#20FFFFFF"
                        CornerRadius="9" Click="LyricsToggle_Click" ToolTipService.ToolTip="Слова песни"/>
                <Button x:Name="LyricsRuBtn" Content="RU" FontSize="10" Padding="8,3"
                        Style="{StaticResource Subtle}"
                        Background="#15FFFFFF" Foreground="#9CA3AF" BorderThickness="1" BorderBrush="#20FFFFFF"
                        CornerRadius="9" Click="LyricsRu_Click" ToolTipService.ToolTip="Перевод строк на русский"/>
                <Border x:Name="StatusBadge" Background="#15FFFFFF" 
                        CornerRadius="10" Padding="8,2" BorderThickness="1" BorderBrush="#20FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Офлайн" FontSize="10" FontWeight="SemiBold" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Track Info Hero -->
        <Grid x:Name="TrackInfoPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Album Art / Icon Box -->
            <Border Grid.Column="0" Width="58" Height="58" CornerRadius="10" Background="#1A2333" 
                    BorderThickness="1" BorderBrush="#30FFFFFF" Margin="0,0,12,0">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <FontIcon x:Name="MusicIcon" Glyph="&#xE8D6;" FontSize="24" Foreground="#107C41" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Track Metadata -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TrackTitleText" Text="Загрузка..." FontSize="15" FontWeight="Bold" 
                           Foreground="#F9FAFB" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TrackArtistText" Text="Подключение к телефону..." FontSize="12" 
                           Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TrackAppText" Text="--" FontSize="10" FontWeight="Bold" 
                           Foreground="#107C41" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Karaoke lyrics -->
        <Grid x:Name="LyricsPanel" Grid.Row="1" Margin="0,2,0,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LyricsStatus" Text="Слова песни" FontSize="9" FontWeight="SemiBold"
                       Foreground="#6B7280" CharacterSpacing="60" Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="LyricPrev" Text="" FontSize="12" Foreground="#4B5563"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.6"
                           Tapped="LyricPrev_Tapped" ToolTipService.ToolTip="Нажми — перейти к этой строке"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- The current line works like YouTube Music: gray text underneath, bright
                     text on top clipped to the fraction already sung, so the highlight
                     sweeps across the line letter by letter as the song plays. -->
                <Grid x:Name="LyricCurHost" HorizontalAlignment="Center"
                      Tapped="LyricCur_Tapped" ToolTipService.ToolTip="Нажми — перейти к этой строке"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <TextBlock x:Name="LyricCurBase" Text="" FontSize="19" FontWeight="Bold"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" TextAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock x:Name="LyricCurFill" Text="" FontSize="19" FontWeight="Bold"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" TextAlignment="Center" Foreground="#F9FAFB"/>
                </Grid>

                <TextBlock x:Name="LyricNext" Text="" FontSize="12" Foreground="#4B5563"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.45"
                           Tapped="LyricNext_Tapped" ToolTipService.ToolTip="Нажми — перейти к этой строке"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid x:Name="ProgressPanel" Grid.Row="2" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="SeekVisual" Height="22" Background="Transparent"
                  SizeChanged="SeekVisual_SizeChanged"
                  PointerPressed="SeekVisual_PointerPressed"
                  PointerMoved="SeekVisual_PointerMoved"
                  PointerReleased="SeekVisual_PointerReleased"
                  PointerCanceled="SeekVisual_PointerCanceled"
                  PointerCaptureLost="SeekVisual_PointerCaptureLost">
                <ProgressBar x:Name="TrackProgress" Minimum="0" Maximum="100" Value="0" Height="5"
                             VerticalAlignment="Center" IsIndeterminate="False" IsHitTestVisible="False"
                             Background="#25FFFFFF" Foreground="#107C41"/>
                <Grid x:Name="SeekThumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Width="14" Height="14" Fill="#33FFFFFF"/>
                    <Ellipse Width="8" Height="8" Fill="#FFFFFFFF"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0,3,0,0">
                <TextBlock x:Name="PositionText" Text="0:00" FontSize="9" FontFamily="Consolas" Foreground="#9CA3AF"/>
                <TextBlock x:Name="DurationText" Text="0:00" HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas" Foreground="#9CA3AF"/>
            </Grid>
        </Grid>

        <!-- Controls & Volume Bar -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Volume Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <Button x:Name="VolDownBtn" Content="-" Width="26" Height="26" Padding="0"
                        Style="{StaticResource Subtle}" 
                        Background="#15FFFFFF" Foreground="#D1D5DB" BorderThickness="0" CornerRadius="13"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="VolDown_Click"/>
                <TextBlock x:Name="VolText" Text="13" FontSize="11" Foreground="#9CA3AF" 
                           VerticalAlignment="Center" Margin="2,0"/>
                <Button x:Name="VolUpBtn" Content="+" Width="26" Height="26" Padding="0"
                        Style="{StaticResource Subtle}" 
                        Background="#15FFFFFF" Foreground="#D1D5DB" BorderThickness="0" CornerRadius="13"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="VolUp_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button x:Name="PrevButton" Width="36" Height="36" Padding="0" CornerRadius="18"
                        Style="{StaticResource Subtle}"
                        Background="#15FFFFFF" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="Prev_Click" ToolTipService.ToolTip="Предыдущий трек">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="15" Foreground="#F3F4F6"/>
                </Button>

                <Button x:Name="PlayButton" Width="46" Height="46" Padding="0" CornerRadius="23"
                        Style="{StaticResource SubtleGreen}"
                        Background="#107C41" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="PlayPause_Click" ToolTipService.ToolTip="Пауза / Воспроизведение">
                    <FontIcon x:Name="PlayIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="19" Foreground="White"/>
                </Button>

                <Button x:Name="NextButton" Width="36" Height="36" Padding="0" CornerRadius="18"
                        Style="{StaticResource Subtle}"
                        Background="#15FFFFFF" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="Next_Click" ToolTipService.ToolTip="Следующий трек">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="15" Foreground="#F3F4F6"/>
                </Button>

                <Button x:Name="LikeButton" Width="36" Height="36" Padding="0" CornerRadius="18"
                        Style="{StaticResource Subtle}"
                        Background="#15FFFFFF" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="Like_Click" ToolTipService.ToolTip="Нравится" Visibility="Collapsed">
                    <TextBlock x:Name="LikeGlyph" Text="♥" FontSize="17" Foreground="#D1D5DB"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="2" Width="28" Height="28" Padding="0" CornerRadius="14"
                    Style="{StaticResource Subtle}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="Refresh_Click"
                    ToolTipService.ToolTip="Обновить вручную">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="13" Foreground="#6B7280"/>
            </Button>
        </Grid>
    </Grid>
</Page>
